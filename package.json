{
  "name": "boneco-do-abismo-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@boneco/client",
    "build": "npm run build --workspace=@boneco/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "sprites:generate": "python3 tools/generate_animation_sprites.py"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
